# Змінні середовища (задаються в Cloudflare Pages → Settings → Environment variables).
# Цей файл — лише документація імен. НІКОЛИ не кладіть сюди реальні значення.

# Фаза 2 — заявки в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Фаза 2 — календар зайнятості (iCal-експорт з екстранету Booking.com)
ICAL_URL_COTTAGE_1=
ICAL_URL_COTTAGE_2=
ICAL_URL_COTTAGE_3=

# Фаза 3 — ШІ-помічник
ANTHROPIC_API_KEY=

# Аналітика: ідентифікатор потоку GA4 (G-XXXXXXXXXX); задається як build-змінна
PUBLIC_GA4_ID=
