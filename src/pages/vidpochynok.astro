---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import services from '../data/site/services.json';
import contacts from '../data/site/contacts.json';
import estate from '../data/site/estate-photos.json';
import play from '../data/site/play.json';

import terraceImg from '../assets/photos/cottage-3/terrace-01.jpg';
import winterImg from '../assets/photos/cottage-2/exterior-02-winter.jpg';

const estateFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/estate/*.jpg',
  { eager: true }
);

const estatePhotos = estate.photos.map((p) => {
  const mod = estateFiles[`../assets/photos/estate/${p.file}`];
  if (!mod) throw new Error(`Фото території не знайдено: ${p.file}`);
  return { src: mod.default, alt: p.alt.uk };
});

/** Фото для карток послуг: шлях у services.json (напр. "estate/pool-01.jpg") */
const servicePhotoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/**/*.jpg',
  { eager: true }
);
const servicePhoto = (path?: string): ImageMetadata | undefined =>
  path ? servicePhotoFiles[`../assets/photos/${path}`]?.default : undefined;

const title = 'Відпочинок і послуги — басейн, чан, сауна, риболовля | Карпатська садиба';
const description =
  'Що робити в Карпатській садибі: басейн з підігрівом і видом на гори, чан, сауна, риболовля у власному ставку, квадроцикли, спортивне поле, походи. Взимку — ГК «Плай» за 5 км.';

const mainPhone = contacts.phones[0];
const seasonLabel: Record<string, string> = {
  summer: 'Літо',
  winter: 'Зима',
  all: 'Цілий рік',
};
const allServices = [...services.wellness, ...services.activities];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Відпочинок на території та поруч</h1>
      <p class="note">
        Усе найважливіше — просто на садибі: басейн, чан і сауна, ставок з рибою, альтанки з
        мангалами, дитячий майданчик і спортивне поле. А за 5 км — <a href="#play">витяги ГК «Плай»</a>.
      </p>

      <div class="cards">
        {allServices.map((service) => {
          const img = servicePhoto((service as { photo?: string }).photo);
          return (
            <article class="card">
              {img && (
                <div class="card__media">
                  <Image class="card__img" src={img} alt={service.name.uk} width={520} height={360} loading="lazy" />
                  <span class={`badge badge--${service.season}`}>{seasonLabel[service.season]}</span>
                </div>
              )}
              <div class="card__body">
                {!img && (
                  <header class="card__head">
                    <h2>{service.name.uk}</h2>
                    <span class={`badge badge--${service.season}`}>{seasonLabel[service.season]}</span>
                  </header>
                )}
                {img && <h2>{service.name.uk}</h2>}
                <p>{service.description.uk}</p>
                <p class="card__price">{service.price.uk}</p>
                {(service as { link?: string }).link && (
                  <a class="card__link" href={(service as { link?: string }).link}>
                    {(service as { linkText?: string }).linkText ?? 'Детальніше →'}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--tinted" id="tereny">
    <div class="container">
      <h2>Територія садиби</h2>
      <p class="note">
        Басейн, ставок, альтанки з мангалами, дитячий майданчик і спортивне поле — усе на одній
        огородженій території. Натисніть на фото, щоб роздивитись більше.
      </p>
      <div class="estate-gallery">
        <Gallery photos={estatePhotos} id="estate" />
      </div>
    </div>
  </section>

  <section class="section" id="play">
    <div class="container">
      <h2>Поруч — курорт «Плай» (5 км)</h2>
      <p class="note">
        За 5 км від садиби — великий гірськолижний і рекреаційний комплекс «Плай». Гості їздять
        туди на день: узимку — на лижі, влітку — на байк-парк і канатну дорогу, цілий рік —
        у СПА, боулінг чи ресторани.
      </p>

      <div class="play-groups">
        <div class="play-group">
          <h3>❄️ Взимку</h3>
          <ul>{play.services.winter.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="play-group">
          <h3>☀️ Влітку</h3>
          <ul>{play.services.summer.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="play-group">
          <h3>🗓️ Цілий рік</h3>
          <ul>{play.services.year.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>

      <h3 class="play-prices-title">Ски-паси й підйомники «Плаю»</h3>
      <p class="note">{play.passes.seasonsNote}</p>
      <div class="table-wrap">
        <table class="play-prices">
          <thead>
            <tr>
              <th>Ски-пас</th>
              {play.passes.columns.map((c) => <th>{c.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {play.passes.time.map((row) => (
              <tr>
                <td>{row.label}</td>
                <td>{row.low} грн</td>
                <td>{row.holiday} грн</td>
                <td>{row.winter} грн</td>
              </tr>
            ))}
            {play.passes.lifts.map((row) => (
              <tr class="play-prices__lift">
                <td>{row.label}</td>
                <td>{row.low} грн</td>
                <td>{row.holiday} грн</td>
                <td>{row.winter} грн</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        {play.passes.multiDayNote} Ціни курорту на сезон 2025/26 — орієнтовні, уточнюйте актуальні
        перед поїздкою. Забронювати житло й трансфер до трас можна в нас:
        <a href={`tel:${mainPhone.tel}`}>{mainPhone.display}</a>.
      </p>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="seasons">
        <figure>
          <Image src={winterImg} alt="Котедж 2 взимку на тлі засніжених Карпат" width={800} />
          <figcaption>Взимку: <a href="#play">«Плай» за 5 км</a>, прокат спорядження на території, чан після трас</figcaption>
        </figure>
        <figure>
          <Image src={terraceImg} alt="Тераса з видом на гори влітку" width={800} />
          <figcaption>Влітку: басейн, риболовля, походи до водоспадів і вершин — <a href="/lokatsiya">що поблизу</a></figcaption>
        </figure>
      </div>
      <a class="btn btn--primary" href={`tel:${mainPhone.tel}`}>
        Запитати про послуги: {mainPhone.display}
      </a>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-block: var(--space-5);
  }

  .section--tinted {
    background: var(--c-green-100);
  }

  .note {
    max-width: 44rem;
    color: var(--c-text-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }

  .card__media {
    position: relative;
  }

  .card__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  /* бейдж сезону поверх фото */
  .card__media .badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    box-shadow: 0 1px 4px rgb(29 53 36 / 0.25);
  }

  .card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__body h2 {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-2);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card__head h2 {
    font-size: var(--fs-h3);
    margin: 0 0 var(--space-2);
  }

  .badge {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.2em 0.8em;
    white-space: nowrap;
  }

  .badge--summer { background: var(--c-wood-100); color: var(--c-wood-700); }
  .badge--winter { background: #e3edf5; color: #2f5d7a; }
  .badge--all { background: var(--c-green-100); color: var(--c-green-800); }

  .card__price {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 700;
    color: var(--c-green-900);
  }

  .card__link {
    margin-top: var(--space-2);
    font-weight: 600;
  }

  .estate-gallery {
    margin-top: var(--space-4);
  }

  /* Курорт «Плай» */
  .play-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-4) 0 var(--space-5);
  }

  .play-group {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: var(--space-4);
  }

  .play-group h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-h3);
  }

  .play-group ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-1);
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  .play-prices-title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-2);
  }

  .table-wrap {
    overflow-x: auto;
    margin-block: var(--space-3);
  }

  .play-prices {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    min-width: 30rem;
  }

  .play-prices th,
  .play-prices td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }

  .play-prices thead th {
    background: var(--c-green-700);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .play-prices td:not(:first-child) {
    font-weight: 700;
    color: var(--c-green-900);
    white-space: nowrap;
  }

  .play-prices__lift td {
    background: var(--c-green-100);
  }

  /* більші мініатюри, ніж у галереї котеджу: 20 фото лягають по 5 у ряд */
  .estate-gallery :global(.gallery) {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }

  .seasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .seasons figure {
    margin: 0;
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .seasons img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .seasons figcaption {
    padding: var(--space-3) var(--space-4);
  }
</style>
