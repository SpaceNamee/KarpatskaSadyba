---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CottageCard from '../components/CottageCard.astro';
import contacts from '../data/site/contacts.json';
import services from '../data/site/services.json';
import estate from '../data/site/estate-photos.json';

import heroImg from '../assets/photos/cottage-2/exterior-01.jpg';
import winterImg from '../assets/photos/cottage-2/exterior-02-winter.jpg';
import summerImg from '../assets/photos/cottage-3/terrace-01.jpg';

const title = 'Карпатська садиба — котеджі на 10–18 осіб біля ГК «Плай», с. Плав\'я';
const description =
  'Три дерев\'яні котеджі для великих компаній та сімей у с. Плав\'я, за 5 км від гірськолижного комплексу «Плай». Басейн з підігрівом, чан, сауна, риболовля. Рейтинг 9.2 на Booking.com.';

const cottages = (await getCollection('cottages')).sort((a, b) => a.data.order - b.data.order);

const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/**/*.{jpg,png,JPG,PNG}',
  { eager: true }
);

const cardImage = (dir: string, file: string) =>
  allPhotos[`../assets/photos/${dir}/${file}`]?.default;

const mainPhone = contacts.phones[0];

const amenities = [
  ...services.wellness.map((s) => s.name.uk),
  'Альтанки та мангал',
  'Риболовля у власному ставку',
  'Дитячий майданчик',
  'Безкоштовний Wi-Fi і парковка',
];

/** Витяг із галереї території: по одному фото на ключову зону, підписи — короткі */
const estateHighlights = [
  { file: 'pool-01.jpg', caption: 'Басейн з підігрівом' },
  { file: 'chan-01.jpg', caption: 'Карпатський чан' },
  { file: 'sauna-01.jpg', caption: 'Сауна' },
  { file: 'pond-01.jpg', caption: 'Ставок з рибою' },
  { file: 'gazebo-01.jpg', caption: 'Альтанки з мангалом' },
  { file: 'grounds-03.jpg', caption: 'Доглянута територія' },
].map((h) => {
  const meta = estate.photos.find((p) => p.file === h.file);
  const src = cardImage('estate', h.file);
  if (!meta || !src) throw new Error(`Фото території не знайдено: ${h.file}`);
  return { ...h, src, alt: meta.alt.uk };
});

const aboutStats = [
  { value: '3', label: 'окремі котеджі' },
  { value: '49', label: 'гостей максимум' },
  { value: '5 км', label: 'до курорту «Плай»' },
  { value: '9.2', label: 'оцінка на Booking' },
];

const praises = [
  'Дуже привітні господарі — допоможуть з раннім заїздом, розпалять камін, підкажуть маршрути',
  'Нові дерев\'яні будинки з неперевершеним запахом дерева',
  'Тепла вода в басейні та гарна підсвітка ввечері',
  'Велика доглянута територія — місця вистачає навіть великій компанії',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Карпатська садиба',
  alternateName: 'Karpatska Sadyba — Carpathian Estate',
  description,
  url: 'https://karpatska-sadyba.com.ua',
  image: 'https://karpatska-sadyba.com.ua/og-image.jpg',
  telephone: mainPhone.tel,
  priceRange: '₴₴',
  currenciesAccepted: 'UAH',
  smokingAllowed: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'вул. Вадрусівка, 121',
    addressLocality: "с. Плав'я",
    addressRegion: 'Львівська область',
    addressCountry: 'UA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: contacts.coordinates.lat, longitude: contacts.coordinates.lng },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: 9.2, bestRating: 10, reviewCount: 100 },
  checkinTime: contacts.checkIn,
  checkoutTime: contacts.checkOut,
  amenityFeature: amenities.map((name) => ({ '@type': 'LocationFeatureSpecification', name })),
};
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="hero">
    <Image class="hero__img" src={heroImg} alt="" width={1920} loading="eager" />
    <div class="hero__content">
      <div class="container">
        <p class="hero__eyebrow">Сколівські Бескиди · с. Плав'я · 5 км до ГК «Плай»</p>
        <h1>Три дерев'яні котеджі на 10–18 осіб — для вашої компанії чи родини</h1>
        <p class="hero__sub">
          Басейн з підігрівом, чан, сауна, риболовля та гори навколо.
          Уся садиба вміщує до 49 гостей.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={`tel:${mainPhone.tel}`}>
            Забронювати: {mainPhone.display}
          </a>
          <a class="btn btn--ghost" href="#kotedzhi">Обрати котедж</a>
        </div>
        <p class="hero__rating">★ 9.2 — оцінка гостей на Booking.com</p>
      </div>
    </div>
  </section>

  <section class="about section">
    <div class="container about__grid">
      <div class="about__text">
        <h2>Запах дерева, тиша гір і місце для всієї компанії</h2>
        <p>
          Садиба стоїть у селі Плав'я на Львівщині — серед пагорбів Сколівських Бескидів.
          Три окремі дерев'яні котеджі здаються повністю: кожен зі своєю кухнею, санвузлами,
          балконом з видом на гори та альтанкою. Для великих подій можна орендувати всю
          садибу цілком.
        </p>
        <blockquote class="about__quote">
          «У стінах наших будиночків можна забути про всі турботи і насолодитись краєвидами
          високих і мальовничих гір»
          <cite>— Михайло, господар</cite>
        </blockquote>
      </div>
      <ul class="about__stats">
        {aboutStats.map((stat) => (
          <li class="about__stat">
            <span class="about__stat-value">{stat.value}</span>
            <span class="about__stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="kotedzhi" class="section">
    <div class="container">
      <h2>Оберіть свій котедж</h2>
      <p class="section__note">
        Кожен котедж здається цілком — територія, альтанка й мангал лише для вашої компанії.
        Можна орендувати і всю садибу: до 49 гостей.
      </p>
      <div class="cards">
        {cottages.map((cottage) => (
          <CottageCard
            href={`/kotedzhi/${cottage.id}`}
            name={cottage.data.name.uk}
            areaM2={cottage.data.areaM2}
            capacityMax={cottage.data.capacityMax}
            summary={cottage.data.summary.uk}
            priceFrom={cottage.data.prices.twoPlusNights}
            image={cardImage(cottage.data.photosDir, cottage.data.cardPhoto)}
            imageAlt={cottage.data.photos.find((p) => p.file === cottage.data.cardPhoto)?.alt.uk}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <h2>Відпочинок на території</h2>
      <p class="section__note">
        Басейн, чан і сауна, ставок з рибою, альтанки з мангалом, спортивне поле й дитячий
        майданчик — усе на одній огородженій території. Взимку — ГК «Плай» за 5 км.
      </p>
      <ul class="amenities">
        {amenities.map((amenity) => <li>{amenity}</li>)}
      </ul>

      <ul class="estate">
        {estateHighlights.map((item) => (
          <li>
            <a class="estate__item hover-lift" href="/vidpochynok#tereny" aria-label={`${item.caption} — усі фото й послуги`}>
              <Image src={item.src} alt={item.alt} width={520} height={390} loading="lazy" />
              <span class="estate__caption">{item.caption}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="estate__actions">
        <a class="btn btn--primary" href="/vidpochynok">Усі можливості та фото території →</a>
      </div>

      <div class="seasons">
        <article class="season">
          <Image src={winterImg} alt="Котедж 2 взимку на тлі засніжених Карпат" width={800} />
          <div class="season__body">
            <h3>Взимку</h3>
            <p>
              ГК «Плай» за 5 км — 6 трас, крісельні витяги, прокат спорядження на території садиби.
              Після катання — гарячий чан і сауна.
            </p>
          </div>
        </article>
        <article class="season">
          <Image src={summerImg} alt="Тераса з видом на гори" width={800} />
          <div class="season__body">
            <h3>Влітку</h3>
            <p>
              Басейн з підігрівом і видом на гори, риболовля, квадроцикли, спортивне поле
              та походи до водоспадів і на вершини Бескидів.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>За що нас люблять гості</h2>
      <p class="rating-badge">★ 9.2 <span>на Booking.com</span></p>
      <ul class="praises">
        {praises.map((praise) => <li>{praise}</li>)}
      </ul>
      <p>
        Більше фото й відгуків —
        <a href={contacts.instagram.url} rel="noopener">в Instagram {contacts.instagram.handle}</a>
      </p>
    </div>
  </section>

  <section id="kontakty" class="section section--tinted">
    <div class="container">
      <h2>Контакти</h2>
      <div class="contacts">
        <div>
          <h3>Бронювання</h3>
          <ul class="contacts__list">
            {contacts.phones.map((phone) => (
              <li><a href={`tel:${phone.tel}`}>{phone.display}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Адреса</h3>
          <p>{contacts.address.uk}</p>
          <p>Заїзд з {contacts.checkIn} · виїзд до {contacts.checkOut}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: clamp(28rem, 78vh, 44rem);
    display: flex;
    align-items: flex-end;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
  }

  .hero__content {
    position: relative;
    width: 100%;
    padding-block: var(--space-6) var(--space-5);
    background: linear-gradient(transparent, rgb(29 53 36 / 0.55) 30%, rgb(29 53 36 / 0.92));
    color: var(--c-text-inverse);
  }

  .hero__content h1 {
    color: #fff;
    max-width: 44rem;
  }

  .hero__eyebrow {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-wood-100);
  }

  .hero__sub {
    font-size: 1.125rem;
    max-width: 38rem;
    color: rgb(247 245 238 / 0.92);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .hero__rating {
    margin-top: var(--space-3);
    font-weight: 700;
    color: var(--c-wood-100);
  }

  .section {
    padding-block: var(--space-6);
  }

  .section--tinted {
    background: var(--c-green-100);
  }

  /* Про садибу */
  .about {
    background: var(--c-green-100);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .about__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-6);
    }
  }

  .about__quote {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-3);
    border-left: 3px solid var(--c-wood-600);
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--c-green-900);
  }

  .about__quote cite {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-style: normal;
    color: var(--c-text-muted);
  }

  .about__stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .about__stat {
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: var(--space-4);
    text-align: center;
  }

  .about__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--c-green-700);
  }

  .about__stat-label {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  .section__note {
    max-width: 42rem;
    color: var(--c-text-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .estate {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: grid;
    /* фіксовані 3 колонки: 6 фото лягають рівно у два ряди, без «сироти» в кінці */
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 48rem) {
    .estate {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .estate__item {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    text-decoration: none;
  }

  .estate__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .estate__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-4) var(--space-3) var(--space-2);
    color: #fff;
    font-weight: 700;
    font-size: var(--fs-small);
    background: linear-gradient(to top, rgb(20 28 22 / 0.85), transparent);
  }

  .estate__actions {
    margin: 0 0 var(--space-5);
  }

  .amenities {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .amenities li {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    padding: var(--space-2) var(--space-3);
    font-weight: 600;
  }

  .seasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-4);
  }

  .season {
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .season img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .season__body {
    padding: var(--space-4);
  }

  .rating-badge {
    display: inline-block;
    background: var(--c-green-700);
    color: #fff;
    font-weight: 700;
    font-size: 1.3rem;
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
  }

  .rating-badge span {
    font-size: var(--fs-small);
    font-weight: 600;
    opacity: 0.85;
  }

  .praises {
    max-width: 44rem;
    display: grid;
    gap: var(--space-2);
    padding-left: 1.2em;
  }

  .contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .contacts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .contacts__list a {
    font-weight: 700;
    text-decoration: none;
  }
</style>
