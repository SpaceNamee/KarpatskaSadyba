---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import contacts from '../data/site/contacts.json';
import policies from '../data/site/policies.json';
import services from '../data/site/services.json';
import booking from '../data/site/booking.json';

const title = 'Ціни на котеджі — Карпатська садиба, с. Плав\'я біля ГК «Плай»';
const description =
  'Актуальні ціни на оренду котеджів на 10–18 осіб у Карпатах: від 9 500 грн/доба за котедж. Чан, сауна, риболовля. Завдаток 3 000 грн підтверджує бронювання.';

const cottages = (await getCollection('cottages')).sort((a, b) => a.data.order - b.data.order);
const mainPhone = contacts.phones[0];

/** Дані для калькулятора вартості (читаються клієнтським скриптом) */
const pricing = cottages.map((c) => ({
  id: c.id,
  name: c.data.name.uk,
  oneNight: c.data.prices.oneNight,
  twoPlusNights: c.data.prices.twoPlusNights,
  includedGuests: c.data.prices.includedGuests,
  extraPersonUah: c.data.prices.extraPersonUah,
  capacityMax: c.data.capacityMax,
}));

const extras = [
  { name: 'Чан + сауна', price: '5 000 грн / 2 год' },
  { name: 'Чан', price: '3 000 грн / 2 год (далі — за домовленістю)' },
  { name: 'Сауна', price: '2 500 грн / 2 год (далі — за домовленістю)' },
  { name: 'Дрова для мангалу', price: '500 грн / тачка' },
  { name: 'Риболовля', price: 'безкоштовно; забрати улов — 300 грн/кг' },
  { name: 'Квадроцикли, трансфер', price: `за домовленістю: ${contacts.extraPhones.quadsAndTransfer.display}` },
  { name: 'Харчування (домашні обіди)', price: `за меню: ${contacts.extraPhones.food.display}`, link: '/menu' },
];

const faq = [
  {
    q: 'Як підтверджується бронювання?',
    a: `Ви телефонуєте або залишаєте заявку, ми узгоджуємо дати й ви вносите завдаток ${policies.depositUah.toLocaleString('uk-UA')} грн банківським переказом. Решта — готівкою при заїзді.`,
  },
  {
    q: 'Що буде із завдатком, якщо скасувати бронь?',
    a: 'При скасуванні або перенесенні за 14 і більше днів до заїзду завдаток повертаємо повністю або зараховуємо на інші дати. Пізніше ніж за 14 днів або при неприїзді — завдаток не повертається.',
  },
  {
    q: 'Скільки коштує додаткове місце?',
    a: 'У ціну кожного котеджу включена базова кількість гостей; кожен наступний гість — 500 грн/доба.',
  },
  {
    q: 'Чи опалюються котеджі взимку?',
    a: 'Так, котеджі опалюються, у деяких є каміни — тепло навіть у морози. Гаряча вода цілий рік.',
  },
  {
    q: 'Чи можна з домашніми тваринами?',
    a: 'За попереднім запитом; можлива додаткова плата. Попередьте, будь ласка, ще під час бронювання.',
  },
  {
    q: 'Що вже є в котеджі, а що взяти з собою?',
    a: 'Постіль, рушники, посуд і кухонна техніка, Wi-Fi — усе на місці. Беріть лише особисті речі та, за бажанням, продукти — або замовте домашню кухню з доставкою.',
  },
  {
    q: 'Де найближчі магазин і банкомат?',
    a: 'Продуктовий магазин — за ~100 м від садиби. Банкомат, аптека й заправка — у сусідніх селах та Славську, за кілька кілометрів.',
  },
  {
    q: 'Чи можна ранній заїзд або пізній виїзд?',
    a: `За можливості так — узгоджуйте заздалегідь. Стандартно заїзд з ${policies.checkIn}, виїзд до ${policies.checkOut}.`,
  },
  {
    q: 'Чи можна орендувати всю садибу?',
    a: 'Так, усі три котеджі разом вміщують до 49 гостей — ідеально для корпоративів і великих свят. Деталі — на сторінці «Події»; телефонуйте, порахуємо індивідуально.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="section">
    <div class="container">
      <h1>Ціни</h1>
      <p class="note">
        Ціни вказані за <strong>весь котедж</strong>, а не за особу.
        ❄️ Зимові ціни можуть відрізнятися — уточнюйте за телефоном.
      </p>

      <div class="table-wrap">
        <table class="prices">
          <thead>
            <tr>
              <th>Котедж</th>
              <th>Гостей</th>
              <th>Від 2 діб (за добу)</th>
              <th>1 доба</th>
            </tr>
          </thead>
          <tbody>
            {cottages.map((cottage) => (
              <tr>
                <td>
                  <a href={`/kotedzhi/${cottage.id}`}>{cottage.data.name.uk}</a>
                  <small>{cottage.data.areaM2} м² · {cottage.data.bedroomsCount} спалень</small>
                </td>
                <td>
                  до {cottage.data.capacityMax}
                  <small>{cottage.data.prices.includedGuests} включено, далі +{cottage.data.prices.extraPersonUah} грн/особа</small>
                </td>
                <td><strong>{cottage.data.prices.twoPlusNights.toLocaleString('uk-UA')} грн</strong></td>
                <td>{cottage.data.prices.oneNight.toLocaleString('uk-UA')} грн</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="deposit">
        💳 Бронь підтверджується завдатком <strong>{policies.depositUah.toLocaleString('uk-UA')} грн</strong>
        (банківський переказ), решта — готівкою при заїзді.
      </p>

      <div class="included">
        <h2>Що входить у ціну</h2>
        <ul class="included__list">
          {booking.included.map((item) => <li>{item}</li>)}
        </ul>
        <p class="included__extra">
          Окремо оплачуються чан, сауна, дрова, харчування та інші послуги —
          <a href="#dodatkovi">див. нижче</a>.
        </p>
      </div>

      <a class="btn btn--primary" href={`tel:${mainPhone.tel}`}>Дізнатись вільні дати: {mainPhone.display}</a>

      <div class="calc" data-calc>
        <h2>Калькулятор вартості</h2>
        <p class="note">
          Порахуйте орієнтовну вартість — за весь період і з однієї особи за ніч.
        </p>
        <div class="calc__controls">
          <label>
            Котедж
            <select data-calc-cottage>
              {pricing.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </label>
          <label>
            Ночей
            <input type="number" min="1" max="30" value="2" data-calc-nights />
          </label>
          <label>
            Гостей
            <input type="number" min="1" max="49" value="10" data-calc-guests />
          </label>
        </div>

        <div class="calc__result">
          <div class="calc__figure calc__figure--main">
            <span class="calc__value" data-calc-total>—</span>
            <span class="calc__label" data-calc-total-label>за весь період</span>
          </div>
          <div class="calc__figure">
            <span class="calc__value" data-calc-night>—</span>
            <span class="calc__label">за добу (весь котедж)</span>
          </div>
          <div class="calc__figure">
            <span class="calc__value" data-calc-person>—</span>
            <span class="calc__label">з однієї особи за ніч</span>
          </div>
        </div>

        <p class="calc__hint" data-calc-hint></p>
        <p class="calc__note">
          Розрахунок орієнтовний; ❄️ зимові ціни можуть відрізнятися.
          Бронь підтверджується завдатком {policies.depositUah.toLocaleString('uk-UA')} грн.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" data-calc-pricing set:html={JSON.stringify(pricing)} />
  <script>
    type Plan = {
      id: string;
      name: string;
      oneNight: number;
      twoPlusNights: number;
      includedGuests: number;
      extraPersonUah: number;
      capacityMax: number;
    };

    const root = document.querySelector<HTMLElement>('[data-calc]');
    const dataEl = document.querySelector<HTMLScriptElement>('[data-calc-pricing]');

    if (root && dataEl) {
      const plans: Plan[] = JSON.parse(dataEl.textContent || '[]');
      const byId = new Map(plans.map((p) => [p.id, p]));

      const cottageSel = root.querySelector<HTMLSelectElement>('[data-calc-cottage]')!;
      const nightsInp = root.querySelector<HTMLInputElement>('[data-calc-nights]')!;
      const guestsInp = root.querySelector<HTMLInputElement>('[data-calc-guests]')!;
      const totalEl = root.querySelector<HTMLElement>('[data-calc-total]')!;
      const totalLabelEl = root.querySelector<HTMLElement>('[data-calc-total-label]')!;
      const nightEl = root.querySelector<HTMLElement>('[data-calc-night]')!;
      const personEl = root.querySelector<HTMLElement>('[data-calc-person]')!;
      const hintEl = root.querySelector<HTMLElement>('[data-calc-hint]')!;

      const uah = (n: number) => `${Math.round(n).toLocaleString('uk-UA')} грн`;

      function update() {
        const plan = byId.get(cottageSel.value);
        if (!plan) return;

        let nights = Math.max(1, Math.floor(Number(nightsInp.value) || 1));
        let guests = Math.max(1, Math.floor(Number(guestsInp.value) || 1));

        // не даємо перевищити місткість котеджу
        if (guests > plan.capacityMax) {
          guests = plan.capacityMax;
          guestsInp.value = String(guests);
        }

        const nightlyBase = nights === 1 ? plan.oneNight : plan.twoPlusNights;
        const extraGuests = Math.max(0, guests - plan.includedGuests);
        const perNight = nightlyBase + extraGuests * plan.extraPersonUah;
        const total = perNight * nights;
        const perPerson = perNight / guests;

        totalEl.textContent = uah(total);
        totalLabelEl.textContent = `за ${nights} ${nightWord(nights)}`;
        nightEl.textContent = uah(perNight);
        personEl.textContent = uah(perPerson);

        const bits: string[] = [];
        if (nights === 1) bits.push('ціна за 1 добу вища, ніж за 2+ діб');
        if (extraGuests > 0)
          bits.push(`${plan.includedGuests} гостей у базовій ціні, +${extraGuests} × ${plan.extraPersonUah} грн/ніч`);
        if (guests >= plan.capacityMax) bits.push(`максимум для цього котеджу — ${plan.capacityMax} гостей`);
        hintEl.textContent = bits.join(' · ');
      }

      function nightWord(n: number) {
        const mod10 = n % 10;
        const mod100 = n % 100;
        if (mod10 === 1 && mod100 !== 11) return 'ніч';
        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'ночі';
        return 'ночей';
      }

      [cottageSel, nightsInp, guestsInp].forEach((el) =>
        el.addEventListener('input', update)
      );
      update();
    }
  </script>

  <section class="section section--tinted" id="dodatkovi">
    <div class="container">
      <h2>Додаткові послуги</h2>
      <div class="table-wrap">
        <table class="prices">
          <tbody>
            {extras.map((extra) => (
              <tr>
                <td>
                  {(extra as { link?: string }).link
                    ? <a href={(extra as { link?: string }).link}>{extra.name}</a>
                    : extra.name}
                </td>
                <td>{extra.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Басейн, дитячий майданчик, спортивне поле, Wi-Fi і парковка —
        <a href="/vidpochynok">безкоштовні для гостей</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Часті питання</h2>
      <div class="faq">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-block: var(--space-5);
  }

  .section--tinted {
    background: var(--c-green-100);
  }

  .note {
    max-width: 44rem;
    color: var(--c-text-muted);
  }

  .table-wrap {
    overflow-x: auto;
    margin-block: var(--space-4);
  }

  .prices {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .prices th,
  .prices td {
    text-align: left;
    padding: var(--space-3);
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }

  .prices thead th {
    background: var(--c-green-700);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .prices small {
    display: block;
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  .deposit {
    margin-block: var(--space-4);
  }

  .included {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-green-700);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: var(--space-4);
    margin-block: var(--space-4);
  }

  .included h2 {
    margin-top: 0;
    font-size: var(--fs-h3);
  }

  .included__list {
    columns: 2 16rem;
    column-gap: var(--space-4);
    margin: 0 0 var(--space-3);
    padding-left: 1.2em;
  }

  .included__list li {
    margin-bottom: var(--space-1);
    break-inside: avoid;
  }

  .included__extra {
    margin: 0;
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  /* Калькулятор вартості */
  .calc {
    margin-top: var(--space-5);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-wood-600);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: var(--space-4);
  }

  .calc h2 {
    margin-top: 0;
  }

  .calc__controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .calc__controls label {
    display: grid;
    gap: var(--space-1);
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .calc__controls select,
  .calc__controls input {
    font: inherit;
    padding: 0.6em 0.8em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg);
    color: var(--c-text);
  }

  .calc__result {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
  }

  .calc__figure {
    background: var(--c-green-100);
    border-radius: var(--radius);
    padding: var(--space-3);
    text-align: center;
  }

  .calc__figure--main {
    background: var(--c-green-700);
  }

  .calc__value {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--c-green-900);
  }

  .calc__figure--main .calc__value {
    color: #fff;
  }

  .calc__label {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  .calc__figure--main .calc__label {
    color: rgb(255 255 255 / 0.85);
  }

  .calc__hint {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-small);
    color: var(--c-text-muted);
    min-height: 1.2em;
  }

  .calc__note {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }

  .faq {
    max-width: 46rem;
    display: grid;
    gap: var(--space-2);
  }

  .faq details {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  .faq summary {
    font-weight: 700;
    cursor: pointer;
    color: var(--c-green-900);
  }

  .faq p {
    margin: var(--space-2) 0 0;
  }
</style>
