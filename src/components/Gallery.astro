---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  /** id для зв'язку галереї з лайтбоксом, унікальний на сторінці */
  id?: string;
}

const { photos, id = 'gallery' } = Astro.props;
---

<div class="gallery" data-gallery={id}>
  {photos.map((photo, i) => (
    <button
      class="gallery__thumb"
      type="button"
      data-index={i}
      aria-label={`Відкрити фото: ${photo.alt}`}
    >
      <Image
        src={photo.src}
        alt={photo.alt}
        width={480}
        height={360}
        loading={i < 3 ? 'eager' : 'lazy'}
      />
    </button>
  ))}
</div>

<dialog class="lightbox" data-lightbox={id}>
  <button class="lightbox__close" type="button" data-close aria-label="Закрити">✕</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-prev aria-label="Попереднє фото">‹</button>
  <div class="lightbox__stage">
    {photos.map((photo, i) => (
      <figure class="lightbox__slide" data-slide={i} hidden>
        <Image src={photo.src} alt={photo.alt} width={1600} loading="lazy" />
        <figcaption>{photo.alt}</figcaption>
      </figure>
    ))}
  </div>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-next aria-label="Наступне фото">›</button>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const id = gallery.dataset.gallery;
    const lightbox = document.querySelector<HTMLDialogElement>(`[data-lightbox="${id}"]`);
    if (!lightbox) return;

    const slides = [...lightbox.querySelectorAll<HTMLElement>('[data-slide]')];
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => (slide.hidden = i !== current));
    };

    gallery.querySelectorAll<HTMLButtonElement>('[data-index]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        show(Number(thumb.dataset.index));
        lightbox.showModal();
      });
    });

    lightbox.querySelector('[data-close]')?.addEventListener('click', () => lightbox.close());
    lightbox.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-2);
  }

  .gallery__thumb {
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--c-border);
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    transition: transform var(--transition);
  }

  .gallery__thumb:hover img {
    transform: scale(1.04);
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(96vw, 90rem);
    max-height: 96vh;
  }

  .lightbox::backdrop {
    background: rgb(20 28 22 / 0.92);
  }

  .lightbox__stage img {
    max-width: 92vw;
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
    margin-inline: auto;
  }

  .lightbox__slide {
    margin: 0;
  }

  .lightbox__slide figcaption {
    color: var(--c-text-inverse);
    text-align: center;
    padding-top: var(--space-2);
    font-size: var(--fs-small);
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    z-index: 2;
    border: 0;
    border-radius: 999px;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.4rem;
    line-height: 1;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    cursor: pointer;
  }

  .lightbox__close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev { left: var(--space-3); }
  .lightbox__nav--next { right: var(--space-3); }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgb(255 255 255 / 0.3);
  }
</style>
