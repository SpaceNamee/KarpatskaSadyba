---
interface Props {
  /** Номер котеджу 1..3 — має збігатися з ICAL_URL_COTTAGE_N */
  cottageNumber: number;
}

const { cottageNumber } = Astro.props;
---

<div class="availability" data-availability={cottageNumber}>
  <h3 class="availability__title">Зайнятість</h3>
  <p class="availability__status">Завантажуємо календар…</p>
  <div class="availability__months" hidden></div>
  <p class="availability__legend" hidden>
    <span class="availability__dot availability__dot--busy"></span> зайнято ·
    <span class="availability__dot"></span> вільно.
    Календар орієнтовний — підтвердження по телефону.
  </p>
</div>

<script>
  const MONTHS = [
    'Січень', 'Лютий', 'Березень', 'Квітень', 'Травень', 'Червень',
    'Липень', 'Серпень', 'Вересень', 'Жовтень', 'Листопад', 'Грудень',
  ];
  const DOW = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Нд'];

  document.querySelectorAll<HTMLElement>('[data-availability]').forEach(async (root) => {
    const cottage = root.dataset.availability;
    const status = root.querySelector<HTMLElement>('.availability__status')!;
    const monthsBox = root.querySelector<HTMLElement>('.availability__months')!;
    const legend = root.querySelector<HTMLElement>('.availability__legend')!;

    let busy: { start: string; end: string }[] = [];
    try {
      const res = await fetch(`/api/availability?cottage=${cottage}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error);
      busy = data.busy;
    } catch {
      status.textContent = 'Календар зайнятості скоро з\'явиться — телефонуйте, підкажемо вільні дати.';
      return;
    }

    const isBusy = (iso: string) => busy.some((b) => iso >= b.start && iso < b.end);
    const pad = (n: number) => String(n).padStart(2, '0');
    const todayIso = (() => {
      const t = new Date();
      return `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`;
    })();

    const now = new Date();
    for (let m = 0; m < 3; m++) {
      const first = new Date(now.getFullYear(), now.getMonth() + m, 1);
      const table = document.createElement('table');
      table.className = 'cal';
      const caption = `${MONTHS[first.getMonth()]} ${first.getFullYear()}`;
      let html = `<caption>${caption}</caption><thead><tr>${DOW.map((d) => `<th>${d}</th>`).join('')}</tr></thead><tbody><tr>`;

      const firstDow = (first.getDay() + 6) % 7; // Пн=0
      html += '<td></td>'.repeat(firstDow);

      const daysInMonth = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
      let cell = firstDow;
      for (let d = 1; d <= daysInMonth; d++) {
        const iso = `${first.getFullYear()}-${pad(first.getMonth() + 1)}-${pad(d)}`;
        const past = iso < todayIso;
        const cls = past ? 'cal__past' : isBusy(iso) ? 'cal__busy' : '';
        html += `<td class="${cls}">${d}</td>`;
        if (++cell % 7 === 0 && d !== daysInMonth) html += '</tr><tr>';
      }
      html += '</tr></tbody>';
      table.innerHTML = html;
      monthsBox.appendChild(table);
    }

    status.hidden = true;
    monthsBox.hidden = false;
    legend.hidden = false;
  });
</script>

<style>
  .availability {
    margin-top: var(--space-4);
    border-top: 1px solid var(--c-border);
    padding-top: var(--space-3);
  }

  .availability__title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-2);
  }

  .availability__status {
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  .availability__months {
    display: grid;
    gap: var(--space-3);
  }

  .availability :global(.cal) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    text-align: center;
  }

  .availability :global(.cal caption) {
    font-weight: 700;
    color: var(--c-green-900);
    padding-bottom: var(--space-1);
    text-align: left;
  }

  .availability :global(.cal th) {
    font-weight: 600;
    color: var(--c-text-muted);
    padding: 2px;
  }

  .availability :global(.cal td) {
    padding: 4px 2px;
    border-radius: 6px;
  }

  .availability :global(.cal__busy) {
    background: #e9d5cd;
    color: #8a4b33;
    text-decoration: line-through;
  }

  .availability :global(.cal__past) {
    color: var(--c-border);
  }

  .availability__legend {
    font-size: var(--fs-small);
    color: var(--c-text-muted);
    margin-top: var(--space-2);
  }

  .availability__dot {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 3px;
    background: var(--c-green-100);
    border: 1px solid var(--c-border);
    vertical-align: middle;
  }

  .availability__dot--busy {
    background: #e9d5cd;
    border-color: #d4a794;
  }
</style>
