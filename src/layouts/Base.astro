---
import '@fontsource/philosopher/700.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'uk' | 'en';
}

const { title, description, lang = 'uk' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/** GA4 вмикається, коли в змінних середовища збірки задано PUBLIC_GA4_ID (формат G-XXXXXXXXXX) */
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2f5d3a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script
          is:inline
          define:vars={{ ga4Id }}
        >
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id);
          document.addEventListener('click', (e) => {
            const tel = e.target instanceof Element && e.target.closest('a[href^="tel:"]');
            if (tel) gtag('event', 'phone_click', { phone: tel.getAttribute('href') });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileCta lang={lang} />
  </body>
</html>
